{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "desentupidoraribeiro.com"
        }
      ],
      "destination": "https://www.desentupidoraribeiro.com/$1",
      "permanent": true
    },
    {
      "source": "/limpeza-fossa-brasilia",
      "destination": "/desentupimento-esgoto-brasilia",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
