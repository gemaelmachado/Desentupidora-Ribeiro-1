RewriteEngine On
RewriteBase /

# 1. Redirect removed pages (e.g. fossa)
RewriteRule ^limpeza-fossa-brasilia/?$ https://www.desentupidoraribeiro.com/desentupimento-esgoto-brasilia [R=301,L]

# 2. Force HTTPS and redirect Non-WWW to WWW to avoid redirect/indexing conflicts
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^desentupidoraribeiro\.com$ [NC]
RewriteRule ^(.*)$ https://www.desentupidoraribeiro.com/$1 [R=301,L]

# 3. Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
